---
// Página de una zona con `texto` (src/lib/paginas.ts, sección `zonas`): /zonas/<slug>/.
// Diseño «cuaderno de ruta»: banda pino con curvas de nivel, migas, «Guía de montaña en <zona>» (`titulo_pagina` de
// la sección, con {zona}), la entrada (`texto_pagina`) y los botones; el texto propio de la zona sobre roca con la
// sierra de la portada de zonas; las actividades de la web en mosaico pizarra (las que tienen ficha, enlazadas); la
// banda naranja de reserva y las otras zonas con página.
import Base from '../../layouts/Base.astro';
import Seccion from '../../components/ui/Seccion.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { escalones, seccion, site, tel, whatsapp } from '../../data/site';
import { enlaceDe, introZona, resumen, tituloZona, zonasConPagina } from '../../lib/paginas';
import type { Zona } from '../../lib/paginas';
import { jsonLdMigas, jsonLdZona, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return zonasConPagina().map((z) => ({ params: { slug: z.slug }, props: { z } }));
}

interface Props { z: Zona }
const { z } = Astro.props;
const base = urlBase(Astro.site);
const titulo = tituloZona(z);
const intro = introZona(z);
const nombreSeccion = String(z.seccion.antetitulo || z.seccion.titulo || 'Zonas').trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${z.idSeccion}` },
  { nombre: z.nombre, ruta: z.url },
];
const c = site.contacto;
const foto = z.imagen || String(z.seccion.imagen || '');
const actividades = seccion('actividades');
const lista = actividades ? actividades.actividades.filter((a) => a?.titulo) : [];
const reserva = seccion('reserva') ? '/#reserva' : site.boton_cabecera?.url || '/#contacto';
const textoReserva = 'Reserva tu salida';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre una salida por ${z.nombre}`);
const otras = zonasConPagina().filter((x) => x !== z);
---

<Base titulo={titulo} descripcion={resumen(z.texto[0] ?? intro)} imagen={foto} ld={[jsonLdMigas(base, migas), jsonLdZona(base, z)]}>
  <Seccion banda="pino" curvas class="zona-cabeza">
    <nav aria-label="Migas de pan" class="migas">
      <ol>
        {migas.map((m, i) => (
          <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
        ))}
      </ol>
    </nav>
    <div class="zona-intro">
      <p class="antetitulo"><Icono nombre="mapa" tam={16} /> {z.nombre}</p>
      <h1 class="titulo-seccion zona-titulo">{titulo}</h1>
      {intro && <p class="titular-texto">{intro}</p>}
      <div class="zona-botones">
        <a class="btn" href={reserva}>{textoReserva}</a>
        {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
        {c.telefono && <a class="btn-sec" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
      </div>
    </div>
  </Seccion>

  <Seccion banda="roca" cresta="suave" class="zona-cuerpo">
    <div class:list={['zona-grid', { 'zona-grid--foto': foto }]}>
      <div class="texto-largo zona-texto">
        {z.texto.map((p) => <p>{p}</p>)}
      </div>
      {foto && (
        <div class="zona-foto">
          <Imagen src={foto} alt={titulo} ancho={1000} alto={750} class="h-full w-full object-cover" />
        </div>
      )}
    </div>
  </Seccion>

  {lista.length > 0 && (
    <section class="banda-pizarra zona-actividades" aria-label={`Actividades en ${z.nombre}`}>
      <div class="contenedor zona-act-cabeza">
        <Titular antetitulo={actividades?.antetitulo} titulo={`Qué hacemos en ${z.nombre}`} />
      </div>
      <ul class="zona-act-lista">
        {lista.map((a) => {
          const n = escalones(a.nivel);
          const href = enlaceDe(a);
          return (
            <li class="zona-act">
              <span class="zona-act-pico" aria-hidden="true" />
              <h3>{href ? <a href={href} class="zona-act-enlace">{a.titulo}</a> : a.titulo}</h3>
              {a.texto && <p class="zona-act-texto">{a.texto}</p>}
              <p class="zona-act-pie dato">
                {a.nivel && (
                  <span class="nivel">
                    {n > 0 && (
                      <span class="nivel-picos" aria-hidden="true">
                        {[1, 2, 3].map((k) => <i class:list={{ lleno: k <= n }} />)}
                      </span>
                    )}
                    {a.nivel}
                  </span>
                )}
                {href && <span class="zona-act-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>}
              </p>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <Seccion banda="chaleco" cresta class="zona-reserva">
    <div class="zona-reserva-fila">
      <div>
        <p class="antetitulo">Reserva</p>
        <h2 class="titulo-seccion">¿Salimos por {z.nombre}?</h2>
        <p class="titular-texto">Dime cuántos sois y qué os apetece, y te propongo fecha y plan.</p>
      </div>
      <div class="zona-botones">
        <a class="btn" href={reserva}>{textoReserva}</a>
        {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
      </div>
    </div>
  </Seccion>

  {otras.length > 0 && (
    <Seccion banda="roca" cresta>
      <h2 class="zona-otras-titulo">También guío en</h2>
      <ul class="zona-otras">
        {otras.map((o) => <li><a class="zona-otra dato" href={o.url}><Icono nombre="mapa" tam={16} /> {o.nombre}</a></li>)}
      </ul>
    </Seccion>
  )}
</Base>

<style>
  .zona-cabeza { padding-block: 1.25rem clamp(3.5rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .6rem; font-family: var(--fuente-titulos); font-stretch: 75%; font-weight: 700; font-size: .95rem; letter-spacing: .12em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .6rem; min-width: 0; }
  .migas li + li::before { content: ""; width: .7rem; height: .6rem; background: var(--c-acento); clip-path: polygon(50% 0, 100% 100%, 0 100%); transform: rotate(90deg); }
  .migas a { text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; text-decoration-color: var(--c-acento); text-underline-offset: 4px; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .zona-intro { margin-top: clamp(1rem, 3vw, 2.5rem); max-width: 56rem; }
  .zona-titulo { font-size: clamp(2.6rem, 9vw, 6rem); overflow-wrap: anywhere; }
  .zona-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .zona-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .zona-cuerpo { padding-bottom: var(--ritmo); }
  .zona-grid { display: grid; gap: 2.5rem; align-items: center; }
  .zona-texto { font-size: 1.15rem; max-width: 44rem; }
  .zona-texto p + p { margin-top: 1.1rem; }
  .zona-foto { aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 6px solid var(--c-acento); background: var(--sima); }
  .zona-actividades { padding-top: var(--ritmo); padding-bottom: var(--alto-cresta); }
  .zona-act-cabeza { padding-bottom: 2rem; }
  .zona-act-lista { display: grid; gap: 3px; background: var(--c-fondo); border-top: 3px solid var(--c-fondo); }
  @media (min-width: 640px) { .zona-act-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .zona-act-lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .zona-act { position: relative; display: flex; flex-direction: column; gap: .6rem; padding: 1.5rem 1rem 1.75rem; background: var(--pizarra); color: var(--c-fondo); }
  @media (min-width: 768px) { .zona-act { padding: 1.75rem; } }
  .zona-act-pico { display: block; width: 1.4rem; height: 1.1rem; background: var(--c-acento); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .zona-act h3 { font-size: clamp(1.8rem, 3vw, 2.3rem); }
  .zona-act-enlace { text-decoration: none; color: inherit; }
  .zona-act-enlace::after { content: ""; position: absolute; inset: 0; }
  .zona-act-enlace:focus-visible { outline: none; }
  .zona-act:has(.zona-act-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: -3px; }
  .zona-act-texto { opacity: .82; }
  .zona-act-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .75rem; }
  .zona-act-ver { display: inline-flex; align-items: center; gap: .3rem; color: var(--c-acento); }
  .zona-reserva-fila { display: grid; gap: 2rem; }
  .zona-otras-titulo { font-size: 2rem; }
  .zona-otras { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.25rem; }
  .zona-otra { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.75rem; padding: .5rem 1rem; border: 2px solid currentColor; text-decoration: none; }
  .zona-otra:hover { background: var(--c-primario); color: var(--sobre-primario); border-color: var(--c-primario); }
  @media (min-width: 1024px) {
    .zona-grid--foto { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 4rem; }
    .zona-reserva-fila { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: center; }
    .zona-reserva-fila .zona-botones { justify-content: flex-end; margin-top: 0; }
  }
</style>
