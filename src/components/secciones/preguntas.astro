---
// Preguntas frecuentes sobre roca con cresta: titular a la izquierda (fijo al hacer scroll en escritorio) y acordeón
// nativo <details> a la derecha, pregunta condensada y pico que gira al abrir, sin JavaScript.
// Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta. También sirve de diseño (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id} banda="roca" cresta="suave">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          </div>
        </div>
        <div class="faq-lista lg:col-span-7">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span class="faq-pregunta">{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true" />
              </summary>
              {p.respuesta && <p class="faq-respuesta">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .faq-lista { border-top: 3px solid var(--c-primario); }
  .faq { border-bottom: 1px solid var(--linea); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding-block: 1.3rem; min-height: 3rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover .faq-pregunta { color: var(--resalte-texto); }
  .faq-pregunta { font-family: var(--fuente-titulos); font-stretch: 75%; font-weight: 700; font-size: clamp(1.45rem, 3vw, 2rem); line-height: 1.02; transition: color .15s ease; }
  .faq-signo { flex-shrink: 0; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: var(--c-primario); }
  .faq-signo::before { content: ""; width: 1rem; height: .8rem; background: var(--sobre-primario); clip-path: polygon(50% 100%, 100% 0, 0 0); transition: transform .2s ease; }
  .faq[open] .faq-signo { background: var(--c-acento); }
  .faq[open] .faq-signo::before { background: var(--sobre-acento); transform: rotate(180deg); }
  .faq-respuesta { padding-bottom: 1.5rem; padding-right: 3.5rem; font-size: 1.08rem; opacity: .85; max-width: 44rem; }
</style>
