---
// Material incluido sobre naranja chaleco con cresta suave: titular partido y rejilla a todo el ancho (2, 3 o 4
// columnas) con icono en un rombo, título y texto (`items: [{titulo, texto, icono}]`). `nota` = lo que trae el
// cliente, en una franja pizarra al final. `cta` opcional. Sin items solo sale el titular.
import { seccion, esExterno } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const items = s?.items.filter((it) => it && it.titulo) ?? [];
---

{
  s && (
    <Seccion id={id} banda="chaleco" cresta="suave">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} partido />
      {items.length > 0 && (
        <ul class="mat-rejilla">
          {items.map((it) => (
            <li class="mat">
              <span class="mat-icono" aria-hidden="true"><Icono nombre={it.icono || 'mochila'} tam={28} /></span>
              <h3 class="mat-titulo">{it.titulo}</h3>
              {it.texto && <p class="mat-texto">{it.texto}</p>}
            </li>
          ))}
        </ul>
      )}
      {(s.nota || s.cta) && (
        <div class="mat-nota">
          {s.nota && <p class="flex items-start gap-3"><Icono nombre="bota" tam={24} class="mat-nota-icono" />{s.nota}</p>}
          {s.cta && <a class="btn" href={s.cta.url} {...(esExterno(s.cta.url) ? { target: '_blank', rel: 'noopener' } : {})}>{s.cta.texto}</a>}
        </div>
      )}
    </Seccion>
  )
}

<style>
  .mat-rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 2px solid currentColor; }
  @media (min-width: 900px) { .mat-rejilla { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .mat-rejilla { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .mat { padding: 1.5rem .9rem 1.6rem 0; border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
  @media (min-width: 640px) { .mat { padding: 2rem 1.75rem 2rem 0; } }
  .mat-icono { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; margin-left: .35rem; transform: rotate(45deg); border: 2px solid currentColor; }
  .mat-icono :global(svg) { transform: rotate(-45deg); }
  .mat-titulo { margin-top: 1.1rem; font-size: clamp(1.35rem, 2.4vw, 1.75rem); line-height: 1; }
  .mat-texto { margin-top: .4rem; font-size: .98rem; opacity: .85; }
  .mat-nota { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding: 1.25rem 1rem; background: var(--pizarra); color: var(--c-fondo); font-size: 1.08rem; }
  @media (min-width: 768px) { .mat-nota { padding: 1.5rem 2rem; } }
  .mat-nota :global(.mat-nota-icono) { flex-shrink: 0; color: var(--c-acento); }
  .mat-nota .btn { background: var(--c-acento); color: var(--sobre-acento); }
</style>
